#!/bin/bash

PROGNAME=$(readlink "$0")
if [ -z "$PROGNAME" ] ; then
    PROGNAME="$0"
fi

PROGDIR=$(dirname "$PROGNAME")
# go up one level
PARENTDIR=$(dirname "$PROGDIR")

if [ -f "$PARENTDIR/dist/absfrontend.jar" ]; then
    ABSFRONTENDJAR="$PARENTDIR/dist/absfrontend.jar"
elif [ -f "$PROGDIR/lib/absfrontend.jar" ]; then
    ABSFRONTENDJAR="$PROGDIR/lib/absfrontend.jar"
else
    echo "Error: could not find absfrontend.jar"
    echo "(expected in $PARENTDIR/dist/ or $PROGDIR/lib/)"
    exit 1
fi

java -jar "$ABSFRONTENDJAR" "$@"
